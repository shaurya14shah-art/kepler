# Copy to .env and adjust. docker compose reads .env automatically; for `kepler serve`, export these.
# Never commit .env: it can hold secrets (it's in .gitignore).

# ---------------------------------------------------------------- data
# Where Kepler stores its data (SQLite). Default: ~/.kepler/kepler.db
# KEPLER_DB=/var/lib/kepler/kepler.db

# Start with a simulated startup's metrics (1) or empty (0). Only matters on first start.
KEPLER_DEMO=1

# ---------------------------------------------------------------- access
# Access gate: every /api route and the dashboard need the workspace access key (dashboard: sign-in screen;
# CLI/SDK: X-Kepler-Key). Keep it on. "off" is only for development on a machine and network you trust.
KEPLER_AUTH=on

# Pin the access key (deployments, CI). Otherwise one is generated on first start: see it with `kepler key`.
# KEPLER_API_KEY=

# Set to "on" when Kepler is served over HTTPS, so the sign-in cookie is only sent over HTTPS.
# KEPLER_SECURE_COOKIES=on

# Where people reach the dashboard (behind your HTTPS proxy): alerts then link straight to each incident.
# KEPLER_PUBLIC_URL=https://kepler.example.com

# Models retrain on their own weekly, and as soon as a metric has 7 days of data. "off": only `kepler train`.
# KEPLER_AUTO_TRAIN=on

# Extra origins allowed to call the API from a browser (comma-separated). Default: same-origin only.
# KEPLER_CORS_ORIGINS=https://grafana.example.com

# ---------------------------------------------------------------- billing (disabled: Kepler is free)
# Nothing can be charged while billing is off. Turning it on also needs a change in the code and prices on your
# plans: read docs/billing.md first. Keys come from your own Razorpay dashboard; never put them anywhere but here.
KEPLER_BILLING=off
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# KEPLER_BILLING_LIVE=no            # live keys (rzp_live_...) are refused unless this is "yes"
# RAZORPAY_PLAN_PRO=plan_...        # Razorpay plan IDs for subscriptions, one per plan in kepler/billing/plans.py

# ---------------------------------------------------------------- Kepler AI library (general knowledge)
# Where it lives: default ~/.kepler/library.db
# KEPLER_LIBRARY=/var/lib/kepler/library.db
# Live Wikipedia lookup when the library doesn't know (also: kepler learn --web on|off). "off" overrides.
# KEPLER_WEB=off
# Your email or URL, added to the User-Agent of Wikipedia requests as Wikimedia asks. Nothing is sent if unset.
# KEPLER_CONTACT=you@example.com
# Where formal write-ups (PDF/LaTeX) are saved. Default: ~/Documents/Kepler
# KEPLER_DOCS=
